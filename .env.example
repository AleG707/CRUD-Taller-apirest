# Puerto del servidor (en Render se inyecta automáticamente)
PORT=8080

# Cadena de conexión a MongoDB Atlas
# Formato: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://tu_usuario:tu_password@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
